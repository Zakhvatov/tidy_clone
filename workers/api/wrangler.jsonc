{
  // T3 · Воркер-посредник. Деплой запускает координатор.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidy-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  // Cloudflare Workers Rate Limiting. namespace_id — числа, уникальные в пределах
  // аккаунта; limit/period — запросы в секунды. Генерация платная (5 ₽/кадр), поэтому
  // создание жёстко ограничено; статус и скачивание дешёвые, но опрашиваются каждые ~3 с.
  "ratelimits": [
    {
      "name": "GENERATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CLASSIFY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "MODELS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "GENERATION_STATUS_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GENERATION_IMAGE_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Настраиваемый список источников для CORS (через запятую).
    "ALLOWED_ORIGINS": "https://zakhvatov.github.io,https://tidy-clone.pages.dev,http://localhost:5173",
    // Модель генерации IskraGen. Дешевле: grok-imagine-image-2-0-text-to-image (5 ₽),
    // nano-banana-2-1 (4 ₽). GPT Image 2 — 7 ₽ за кадр 1K.
    "ISKRAGEN_MODEL_SLUG": "gpt-image-2-text-to-image"
  }
}
