# Пример переменных сборки корневого PWA (T3-hardening).
# Скопируйте в `.env.local` (не коммитится) или задайте в CI Pages.

# Базовый URL воркера-посредника `tidy-api`.
VITE_TIDY_API_URL=https://tidy-api.megabaff2011.workers.dev

# T22: клиентского токена в сборке больше нет. Пользователь один раз вводит
# токен доступа в приложении (вкладка «Данные» → «Доступ к генерации», экран
# `/access`); приложение хранит его в localStorage этого устройства и шлёт
# заголовком `x-tidy-client`. Токены задаются секретами воркера:
#   npx wrangler secret put ACCESS_TOKENS   # список через запятую
#   npx wrangler secret put CLIENT_TOKEN    # совместимость, то же значение
